# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "anon" (veya yeni "publishable") anahtar. Tarayıcıda görünmesi güvenlidir; RLS ile korunur.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Saatlerin ve gün gruplamasının yapılacağı saat dilimi (opsiyonel, varsayılan Europe/Istanbul)
NEXT_PUBLIC_APP_TIMEZONE=Europe/Istanbul


# SADECE SUNUCU: yönetim paneli (personel/işletme ekleme) ve "npm run user:create" için.
# Vercel'e de eklenir ama ASLA NEXT_PUBLIC_ ile başlatmayın; tarayıcıya hiç gönderilmez.
SUPABASE_SERVICE_ROLE_KEY=

# Bildirimler (Web Push, ücretsiz). Anahtar üretmek için: npx web-push generate-vapid-keys
# Public anahtar tarayıcıya gider; private anahtar yalnızca sunucuda kalır. Vercel'e de eklenir.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:bildirim@mesaigo.app
